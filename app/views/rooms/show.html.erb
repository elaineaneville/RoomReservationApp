<h1><%= @room.name %></h1>
<p>Site: <%= link_to @room.site.name, site_path(@room.site) %></p>
<p>Capacity: <%= @room.capacity %></p>
<p>Description: <%= @room.description %></p>
<h2>Make a Reservation for this Room</h2>
