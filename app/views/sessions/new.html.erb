<h1>Sign in</h1>

<%= form_with(url: login_path, method: :post, local: true) do |form| %>
  <div>
    <%= form.label :email %>
    <%= form.email_field :email, required: true, autofocus: true %>
  </div>
  <div>
    <%= form.label :password %>
    <%= form.password_field :password, required: true %>
  </div>
  <%= form.submit "Sign in" %>
<% end %>